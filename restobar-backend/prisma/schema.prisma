datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
}

enum TableStatus {
  FREE
  BUSY
  WAITING_BILL
}

enum OrderStatus {
  PENDING_APPROVAL // Creada por el cliente mediante el QR, esperando visto bueno del garzón
  PENDING          // Aprobada por el garzón, en cola para entrar a cocina
  IN_PREPARATION   // Cocina la tomó
  READY            // Lista para retirar
  DELIVERED        // En mesa
  PAID             // Pagada en caja
  CANCELLED        // Rechazada o anulada
}

enum PaymentMethod {
  CASH
  POS_DEBIT
  POS_CREDIT
  TRANSFER
  MIXED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(WAITER)
  createdAt DateTime @default(now())
}

model Table {
  id     String      @id @default(uuid())
  number Int         @unique
  status TableStatus @default(FREE)
  orders Order[]
  cashSales CashSale[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?     // Descripción del plato o bebida para el menú del cliente
  price       Float
  image       String?     // URL de la foto del plato
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id          String      @id @default(uuid())
  tableId     String
  table       Table       @relation(fields: [tableId], references: [id])
  status      OrderStatus @default(PENDING_APPROVAL)
  totalAmount Float       @default(0)
  items       OrderItem[]
  payment     Payment?
  cashSaleOrder CashSaleOrder?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float @default(0)  // Precio congelado al momento de realizar la compra
  notes     String?
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Float
  paymentMethod PaymentMethod
  referenceNum  String?       // Código de autorización o voucher del POS
  createdAt     DateTime      @default(now())
}

model CashSale {
  id            String        @id @default(uuid())
  tableId       String
  table         Table         @relation(fields: [tableId], references: [id])
  totalAmount   Float
  paymentMethod PaymentMethod?
  referenceNum  String?
  isReconciled  Boolean       @default(false)
  orders        CashSaleOrder[]
  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([tableId, createdAt])
}

model CashSaleOrder {
  cashSaleId String
  orderId    String   @unique
  cashSale   CashSale @relation(fields: [cashSaleId], references: [id], onDelete: Restrict)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([cashSaleId, orderId])
  @@index([cashSaleId])
}

model ShiftClose {
  id              String   @id @default(uuid())
  openedAt        DateTime
  closedAt        DateTime @default(now())
  totalCash       Float    // Total recaudado en efectivo
  totalPos        Float    // Total recaudado en tarjetas (Débito + Crédito)
  totalAmount     Float    // Gran total del turno
  totalPosDebit   Float    @default(0)
  totalPosCredit  Float    @default(0)
  totalTransfer   Float    @default(0)
  totalMixed      Float    @default(0)
  totalUnassigned Float    @default(0)
  salesCount      Int      @default(0)
}
